{
  "name": "juice-company-enterprise",
  "version": "1.0.0",
  "description": "Full-stack Juice Manufacturing Enterprise Dashboard and 3D Showcase",
  "scripts": {
    "seed": "npm --prefix juice-company-backend run seed",
    "server": "npm --prefix juice-company-backend run start",
    "dev": "concurrently \"npm run server\" \"http-server . -p 3000 --cors\"",
    "dev:carbon": "npm --prefix juice-company-backend run dev:carbon",
    "start:carbon": "npm --prefix juice-company-backend run start:carbon",
    "build:carbon": "npm --prefix juice-company-backend run build:carbon",
    "db:push": "npm --prefix juice-company-backend run db:push",
    "db:generate": "npm --prefix juice-company-backend run db:generate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1"
  }
}
